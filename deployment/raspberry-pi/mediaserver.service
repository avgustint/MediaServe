[Unit]
Description=MediaServer Node.js Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avgustin
Group=avgustin
WorkingDirectory=/home/avgustin/Desktop/MediaServer/dist/server
Environment="NODE_ENV=production"
Environment="PORT=5000"
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediaserver

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
# Auto-enable on installation
# Run: sudo systemctl enable mediaserver.service

