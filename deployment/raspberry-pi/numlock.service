[Unit]
Description=Enable Num Lock on Console and X Server
After=graphical.target
Wants=graphical.target

[Service]
Type=oneshot
User=avgustin
Group=avgustin
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/avgustin/.Xauthority"
# Wait for X server to be ready (up to 30 seconds)
ExecStartPre=/bin/bash -c 'for i in {1..30}; do xdpyinfo -display :0 >/dev/null 2>&1 && echo "X server is ready" && break || sleep 1; done'
# Wait a bit more for X to fully initialize
ExecStartPre=/bin/sleep 2
# Enable Num Lock at X11 level with retry logic
# Try numlockx first (up to 5 times), then fallback to xdotool if available
ExecStart=/bin/bash -c 'echo "Attempting to enable Num Lock..."; for i in {1..5}; do if /usr/bin/numlockx on 2>&1; then echo "Num Lock enabled successfully using numlockx"; exit 0; fi; echo "Attempt $i failed, retrying..."; sleep 1; done; if command -v xdotool >/dev/null 2>&1; then echo "numlockx failed, trying xdotool..."; for i in {1..3}; do DISPLAY=:0 xdotool key Num_Lock 2>&1 && sleep 0.5 && DISPLAY=:0 xdotool key Num_Lock 2>&1 && echo "Num Lock enabled using xdotool" && exit 0 || sleep 1; done; fi; echo "Failed to enable Num Lock"; exit 1'
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target

