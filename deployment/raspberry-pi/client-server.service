[Unit]
Description=MediaServer Client App Static Server
After=network.target mediaserver.service
Requires=mediaserver.service
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/mediaserver/dist
Environment="PORT=5001"
ExecStart=/usr/bin/node /home/pi/mediaserver/deployment/raspberry-pi/client-server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=client-server

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

