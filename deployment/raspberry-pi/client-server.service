[Unit]
Description=MediaServer Client App Static Server
After=network-online.target mediaserver.service
Requires=mediaserver.service
Wants=network-online.target

[Service]
Type=simple
User=avgustin
Group=avgustin
WorkingDirectory=/home/avgustin/Desktop/MediaServer/dist
Environment="PORT=5001"
ExecStart=/usr/bin/node /home/avgustin/Desktop/MediaServer/deployment/raspberry-pi/client-server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=client-server

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

